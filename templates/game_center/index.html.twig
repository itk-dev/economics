<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Game center</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <div class="game-center container-fluid">
    <h1>Game center</h1>

    {% if games %}
    <ul class="list-group">
        {% for id, name in games %}
            <li class="list-group-item"><a class="link-underline link-underline-opacity-0 stretched-link" href="{{ path('game_center_play', {game: id}) }}">{{ name }}</a></li>
        {% endfor %}
    </ul>
    {% else %}
        <p>No games make a dull boy …</p>
    {% endif %}
    </div>
</body>
