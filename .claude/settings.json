{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "enabledPlugins": {
        "php-lsp@claude-plugins-official": true,
        "playwright@claude-plugins-official": true
    },
    "enabledMcpjsonServers": [
        "context7"
    ],
    "permissions": {
        "allow": [
            "Bash(task)",
            "Bash(task --list)",
            "Bash(task --list-all)",
            "Bash(task coding-standards:*)",
            "Bash(task code-analysis*)",
            "Bash(task test)",
            "Bash(task test:*)",

            "Bash(task composer -- show:*)",
            "Bash(task composer -- outdated:*)",
            "Bash(task composer -- validate:*)",
            "Bash(task composer -- audit:*)",

            "Bash(docker compose ps:*)",
            "Bash(docker compose logs:*)",
            "Bash(docker compose config:*)"
        ],
        "deny": [
            "Bash(git push --delete*)",
            "Bash(gh auth login*)",
            "Bash(gh auth logout*)",
            "Bash(gh auth refresh*)",
            "Bash(gh auth setup-git*)",
            "Bash(gh pr close*)",
            "Bash(gh pr reopen*)",
            "Bash(gh pr merge*)",
            "Bash(gh pr ready*)",
            "Bash(gh pr review*)",
            "Bash(gh pr lock*)",
            "Bash(gh pr unlock*)",
            "Bash(gh pr update-branch*)",
            "Bash(gh issue create*)",
            "Bash(gh issue edit*)",
            "Bash(gh issue close*)",
            "Bash(gh issue reopen*)",
            "Bash(gh issue comment*)",
            "Bash(gh issue delete*)",
            "Bash(gh issue lock*)",
            "Bash(gh issue unlock*)",
            "Bash(gh issue pin*)",
            "Bash(gh issue unpin*)",
            "Bash(gh issue transfer*)",
            "Bash(gh issue develop*)",
            "Bash(gh repo create*)",
            "Bash(gh repo delete*)",
            "Bash(gh repo edit*)",
            "Bash(gh repo rename*)",
            "Bash(gh repo archive*)",
            "Bash(gh repo unarchive*)",
            "Bash(gh repo fork*)",
            "Bash(gh repo sync*)",
            "Bash(gh repo deploy-key add*)",
            "Bash(gh repo deploy-key delete*)",
            "Bash(gh release create*)",
            "Bash(gh release delete*)",
            "Bash(gh release edit*)",
            "Bash(gh release upload*)",
            "Bash(gh release delete-asset*)",
